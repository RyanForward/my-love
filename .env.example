# Produção: precisa do prefixo VITE_ pra o Vite expor a variável no bundle do navegador.
# Também exposto no JS — prefira proxy/backend se a chave for sensível.
VITE_ASTROLOGY_USER_ID=
VITE_ASTROLOGY_API_KEY=

# Supabase (Project Settings > API). A anon key é pública por design —
# a proteção real vem das políticas de RLS da tabela "eventos".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha simples exigida para cadastrar evento (fica exposta no JS, é só uma
# barreira contra edição casual — não é segurança de verdade).
VITE_EVENTOS_PASSWORD=
